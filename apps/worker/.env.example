# Worker only (runs on the owner's machine). Never copy these into apps/web.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Scoped, per-project tokens are supplied per run, never account-wide tokens.
# Stage runner: at most this many projects run in parallel (one run per project at a time).
WORKER_MAX_PARALLEL_PROJECTS=2
# Pipeline email (D-167, D-224): the owner's Gmail over SMTP with an app password.
# Creating an app password needs 2-step verification on the Google account. Gmail limits daily sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=
# Where owner alerts go (gate ready, pause request waiting, run failed).
OWNER_ALERT_EMAIL=
# GitHub App used to mint short-lived, single-repository tokens for each run.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# One-time owner bootstrap (pnpm --filter @wpe/worker bootstrap-owner). Remove OWNER_PASSWORD afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=
