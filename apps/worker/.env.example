# Worker only (runs on the owner's machine). Never copy these into apps/web.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Scoped, per-project tokens are supplied per run, never account-wide tokens.
# Stage runner: at most this many projects run in parallel (one run per project at a time).
WORKER_MAX_PARALLEL_PROJECTS=2
