# Copy to scripts/.env.backup (gitignored) and fill in. Never commit the real file.
SUPABASE_DB_URL=
# age public key (starts with "age1"). Create the pair with: age-keygen -o ~/wpe-age-key.txt (outside the repo)
# Put the key file in your password manager, then delete it from disk. Only the public key goes here.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=
BACKUP_CLOUD_DIR=
BACKUP_KEEP_DAYS=180
