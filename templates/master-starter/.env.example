# Contact form mail settings (set in the hosting provider, never committed).
# MAIL_TRANSPORT: smtp (generic SMTP, Google Workspace, Gmail app password), microsoft365, or stub (nothing is sent).
MAIL_TRANSPORT=stub
MAIL_TO=
MAIL_FROM=
# smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# microsoft365 (OAuth 2.0, app-only)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_USER=
# Only when the PRD asks for Cloudflare Turnstile (the site key goes in content/settings.json)
TURNSTILE_SECRET_KEY=
